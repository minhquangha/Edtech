{
  "name": "Edtech",
  "type": "module",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "vitest run",
    "test:eval": "tsx -r dotenv/config -r tsconfig-paths/register test/eval/runners/run-all.ts",
    "test:eval:d": "tsx -r dotenv/config -r tsconfig-paths/register test/eval/runners/feature1-matrix.eval.ts",
    "test:eval:p": "tsx -r dotenv/config -r tsconfig-paths/register test/eval/runners/feature2-pdf.eval.ts",
    "test:perf": "tsx test/performance/node-runner.js",
    "test:load": "tsx test/performance/http-runner.js",
    "dev": "tsx watch -r tsconfig-paths/register src/index.ts",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "postinstall": "prisma generate",
    "start": "tsx -r tsconfig-paths/register src/index.ts",
    "create-admin": "tsx -r tsconfig-paths/register src/scripts/create-admin.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.21.0",
  "dependencies": {
    "@google/genai": "^2.16.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.1",
    "openai": "^7.5.0",
    "pdf-parse": "^2.4.5",
    "pdf-to-img": "^6.2.0",
    "pg": "^8.23.0",
    "prisma": "^7.8.0",
    "tesseract.js": "^7.0.0",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.21.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@prisma/config": "^7.9.1",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.3.3",
    "@types/pg": "^8.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "pnpm": {
    "overrides": {
      "pdfjs-dist": "5.6.205"
    }
  }
